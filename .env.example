# Somnia Testnet Configuration
# Copy this file to .env and fill in your values

# Your wallet private key (DO NOT share this!)
# Get testnet STT from: https://somnia-testnet.fauchard.xyz/
SOMNIA_PRIVATE_KEY=your_private_key_here

# Alternative (used by some tools)
PRIVATE_KEY=your_private_key_here

# Storacha IPFS Configuration (for custom NFT images)
# Get these from: https://storacha.network/
VITE_STORACHA_KEY=your_storacha_key_here
VITE_STORACHA_PROOF=your_storacha_proof_here
VITE_STORACHA_SPACE_DID=your_storacha_space_did_here
